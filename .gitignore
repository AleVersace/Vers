# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.devserver.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
tsconfig.tsbuildinfo

# local credentials
*-firebase-adminsdk-*.json
firebase-service-account*.json

# Private credentials and recovery data (never part of an open-source export)
/credentials/
/secrets/
/backups/
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
credentials.json
service-account*.json
service_account*.json
*.db
*.sqlite*
*.dump
*.sql.gz
*.backup
*.bundle
backup*.sql
dump*.sql
.openai/
