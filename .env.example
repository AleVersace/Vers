# Public web configuration from YOUR Supabase and Firebase projects.
# See docs/CONFIGURATION.md for origins, scopes and private-key formatting.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# New installations use this bucket. Upgrades must use their existing bucket ID.
NEXT_PUBLIC_ASSET_BUCKET=vers-assets
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-web-app-id

# Optional legacy fields, unused by the application. Files use Supabase Storage.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server only. Never prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SECRET_KEY=
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Local setup only; used once for a NEW installation, never shipped to browsers.
VERS_INITIAL_MASTER_EMAIL=
VERS_INITIAL_CAMPAIGN_NAME=
# Optional credential path for the manual Firebase role maintenance script.
GOOGLE_APPLICATION_CREDENTIALS=
# Set to the source of the exact deployed version before public distribution.
NEXT_PUBLIC_SOURCE_URL=
